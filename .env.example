# ── Hamster Fijas — desarrollo local ───────────────────────────────────────
# Copia este archivo:  cp .env.example .env
# Producción (Render): https://predicciones-futbol-tmyr.onrender.com/

# Entorno: development | production
ENVIRONMENT=development

# Base de datos
# Opción A (rápida): SQLite local — deja comentado DATABASE_URL
# Opción B (como Render): PostgreSQL con Docker — descomenta la línea de abajo
#   y ejecuta:  make db-up
# DATABASE_URL=postgresql://predicciones:predicciones@localhost:5432/predicciones

# Sesiones (obligatorio en producción; en local usa el valor por defecto)
SECRET_KEY=dev-secret-cambiar-en-produccion

# Cookies seguras — false en local, true en Render
HTTPS_ONLY=false

# Google OAuth — mismas credenciales que Render, con URIs de redirect extra:
#   http://127.0.0.1:8000/auth/callback
#   http://localhost:8000/auth/callback
#   https://predicciones-futbol-tmyr.onrender.com/auth/callback
#   (cuando conectes hamsterfijas.com, añade también sus URIs — ver docs/LANZAMIENTO.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails con rol admin (separados por coma)
ADMIN_EMAILS=tu-email@gmail.com

# Celular único por cuenta — false en development para pruebas con el mismo número
# ENFORCE_UNIQUE_PHONE=false

# Twilio Verify — SMS (https://www.twilio.com/console)
# Si está configurado, se usa en local y producción. Sin Twilio en development: código 123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Analíticas (opcional; cookie-consent.js las carga solo con "Aceptar todo")
# GA: Admin Analytics → Flujos de datos → ID de medición (G-...)
# Clarity: Settings → Setup → Project ID (en la URL del script clarity.ms/tag/...)
GA_MEASUREMENT_ID=G-W394R9W8E7
CLARITY_PROJECT_ID=x51o85xggi

# URL pública del sitio (SEO: canonical, Open Graph, sitemap)
SITE_URL=https://predicciones-futbol-tmyr.onrender.com

# Pagos Yape — activo en development por defecto; en producción usa true explícito
YAPE_PAYMENTS_ENABLED=true
# (legacy) YAPE_PAYMENTS_BETA=true también activa; false ya no desactiva (usaba significar “no beta”)
# Número Yape (opcional, solo uso interno — no se muestra en la web si hay QR)
YAPE_RECIPIENT_PHONE=999999999

# QR Yape (no va en /static — carpeta privada, gitignored)
# Local: guarda tu imagen como app/private/yape/qr.png
# Render (recomendado): Secret File en Dashboard → Environment → Secret Files
#   Filename: yape-qr.b64   Contents: contenido de app/private/yape/qr.base64.txt
#   (./scripts/encode-yape-qr.sh genera ese archivo)
# Alternativa pequeña: YAPE_QR_BASE64=... (evita pegar >100 KB; puede romper el deploy)
# YAPE_QR_SECRET_PATH=/etc/secrets/yape-qr.b64
# YAPE_QR_MEDIA_TYPE=image/png
# YAPE_QR_FILE=qr.png
